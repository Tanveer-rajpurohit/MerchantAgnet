ENVIRONMENT=development
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:3001"]
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/merchant_agent
REDIS_URL=redis://localhost:6379/0

SECRET_KEY=change-this-to-a-secure-random-32-byte-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret


AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=merchantagent-assets


CREDENTIALS_ENCRYPTION_KEY=32-byte-URL-safe-base64-encoded-string
FRONTEND_URL=http://localhost:3001


AGENT_BASE_URL=https://api.groq.com/openai/v1
AGENT_API_KEY=gsk_key-for-your-agent
AGENT_MODEL=llama-3.3-70b-versatile

# Vector Embedding Dimension
EMBEDDING_DIM=384